{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend/nflstats-pro-ui && npm ci && npm run build",
  "devCommand": "cd frontend/nflstats-pro-ui && npm run dev",
  "installCommand": "cd frontend/nflstats-pro-ui && npm ci",
  "outputDirectory": "frontend/nflstats-pro-ui/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://nflstats-api.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "env": {
    "VITE_API_BASE": "https://nflstats-api.onrender.com/api/v1"
  }
}
