# Frontend environment — copy to .env.local for local development
# In production, set via Vercel Environment Variables dashboard

# URL of the deployed backend API (include /api/v1 path segment)
# Development: leave unset — vite.config.ts proxy handles routing
# Production:  https://your-app-name.onrender.com/api/v1
VITE_API_BASE=http://localhost:8000/api/v1
