# Frontend environment — copy to .env.local for local development
# In production, set via Vercel Environment Variables dashboard

# Backend API base URL. REQUIRED for production builds — the app throws at
# build/runtime if neither VITE_API_BASE nor VITE_API_BASE_URL is set when PROD.
# CI uses a placeholder URL; Vercel overrides with the real value at deploy time.
#
# Provide ONE of:
#   VITE_API_BASE      Full base including the /api/v1 path segment
#                      e.g. https://your-app-name.onrender.com/api/v1
#   VITE_API_BASE_URL  Origin only; /api/v1 is appended automatically
#                      e.g. https://your-app-name.onrender.com
#
# Local development: leave both unset — vite.config.ts proxy handles routing
# (falls back to http://localhost:8000/api/v1).
# VITE_API_BASE=https://nflstats-api.onrender.com/api/v1
