# Backend environment — copy to .env for local development
# In production, set via Render environment variables dashboard

# Comma-separated list of allowed frontend origins
# Development default (set in main.py): http://localhost:5173,http://localhost:3000
# Production: https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL connection (future features)
# Default for local: postgresql://postgres:postgres@localhost:5432/nflstats
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nflstats

# Server port (Render sets PORT automatically in production)
PORT=8000
